---
import { HOME_LINKS } from "../consts";
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro"
import Link from "../components/Link.astro";

const recentAiPosts = (await getCollection("blog"))
  .filter((post) => post.data.lang === "zh" && post.data.tags.some((tag) => /AI|LLM|MCP|Agent/i.test(tag)))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);
---

<MainLayout title="HUTAO667" description="HUTAO667 的个人技术博客，分享 AI 应用开发、项目实践和技术思考。" lang="zh">
  <div class="home-hero container flex items-center justify-center mx-auto px-6">
    <div class="home-stack container-2 flex flex-col items-center text-center py-4 animate-fade-in w-full">
      <div class="logo-name flex flex-col sm:flex-row items-center justify-center gap-3 animate-slide-up" style="animation-delay: 0.1s;">
        <img src="/favicon.ico" alt="HUTAO667 Logo" class="home-avatar w-24 h-24 sm:w-36 sm:h-36 select-none rounded-full object-cover" />
        <span style="font-family: Electrolize" class="home-title text-5xl sm:text-8xl select-none">HUTAO667</span>
      </div>
      <div class="home-links links py-3 animate-slide-up flex flex-wrap justify-center gap-2 sm:gap-3" style="animation-delay: 0.3s;">
        {HOME_LINKS.map((item) => (
          <Link href={item.href} className="text-lg sm:text-2xl px-4 select-none">{item.label}</Link>
        ))}
      </div>
      <p class="home-intro font-mono max-w-2xl select-none text-sm sm:text-base animate-slide-up px-4" style="animation-delay: 0.5s;">
        一名专注于 AI 应用开发的工程师，探索 LLM、MCP、Function Calling 等技术在实际项目中的应用。了解更多 <Link href="/about" className="underline font-medium text-color-2">关于我</Link>
      </p>
    </div>
  </div>

  <section class="container-2 mx-auto w-full max-w-4xl px-6 pb-8" aria-labelledby="recent-ai-posts">
    <div class="mb-4 flex items-center justify-between border-b border-border pb-2">
      <h2 id="recent-ai-posts" class="text-xl font-semibold text-foreground">AI 相关文章</h2>
      <Link href="/blog" className="text-sm text-muted-foreground underline">查看全部</Link>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      {recentAiPosts.map((post) => (
        <Link href={`/${post.id}/`} className="rounded-lg border border-border bg-muted/20 p-4 text-left transition-colors hover:bg-muted/40">
          <h3 class="mb-1 line-clamp-2 font-medium text-foreground">{post.data.title}</h3>
          <p class="line-clamp-2 text-sm text-muted-foreground">{post.data.description}</p>
        </Link>
      ))}
    </div>
  </section>

  <style>
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in { animation: fadeIn 0.6s ease-out forwards; }
    .animate-slide-up { opacity: 0; animation: slideUp 0.8s ease-out forwards; }
  </style>
</MainLayout>
